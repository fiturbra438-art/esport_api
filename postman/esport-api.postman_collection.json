    {
      "name": "1. Register captain",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('captainUsername', `pm_captain_${suffix}`);",
              "pm.collectionVariables.set('demoPassword', 'Postman-Demo-Password-123!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registrasi captain berhasil dan tidak membocorkan password', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.data.username).to.eql(pm.collectionVariables.get('captainUsername'));",
              "    pm.expect(body.data.id).to.be.a('number');",
              "    pm.expect(body.data).not.to.have.property('password');",
              "    pm.collectionVariables.set('captainId', String(body.data.id));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{captainUsername}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"mmr_point\": 1200\n}",
          "options": {
            "raw": {
